{
  "expo": {
    "name": "DocLock",
    "slug": "doclock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "doclock",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doclock.app"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "android": {
      "package": "com.doclock.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F8FBFF"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MaterialIcons.ttf",
            "./assets/fonts/material.ttf"
          ]
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4dada614-e04c-4599-bb87-4df5fa184132"
      }
    },
    "owner": "doubleeusolutions"
  }
}
